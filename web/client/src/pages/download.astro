---
// Download Page — Sent-Code IDE
const currentVersion = "1.0.0";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Download Sent-Code — Free Desktop AI IDE</title>
</head>
<body class="bg-[#0b0c0e] text-[#d4d6da] font-sans min-h-screen">

  <!-- Nav -->
  <header class="border-b border-[#151820] py-4 px-6">
    <nav class="max-w-5xl mx-auto flex items-center justify-between">
      <a href="/" class="flex items-center gap-2.5">
        <div class="w-7 h-7 rounded-lg bg-gradient-to-tr from-cyan-500 to-emerald-400 text-gray-950 flex items-center justify-center font-bold text-sm">⚡</div>
        <span class="font-bold text-white text-sm">Sent-Code</span>
      </a>
      <a href="/" class="text-xs text-gray-500 hover:text-white transition">← Back to Home</a>
    </nav>
  </header>

  <main class="max-w-3xl mx-auto px-6 py-20">
    <div class="text-center mb-14">
      <h1 class="text-4xl font-extrabold text-white mb-4">Download Sent-Code IDE</h1>
      <p class="text-gray-400 text-sm">Free for personal use. Runs locally. No subscription needed.</p>
    </div>

    <!-- Windows Download Card -->
    <div class="bg-[#111318] rounded-2xl border border-[#1b1e27] p-8 mb-6">
      <div class="flex items-start justify-between mb-6">
        <div>
          <h2 class="text-white font-bold text-lg mb-1">Windows Desktop</h2>
          <p class="text-gray-500 text-xs">Windows 10/11 (64-bit) — Built with Go + Wails + React</p>
        </div>
        <span class="px-2.5 py-1 rounded-lg bg-[#1a1d25] text-cyan-400 text-xs font-mono border border-[#22253a]">v{currentVersion}</span>
      </div>
      
      <a href="/download/Sent-Code-Setup.exe"
         class="flex items-center justify-center gap-3 w-full py-4 bg-gradient-to-r from-cyan-500 to-emerald-500 hover:from-cyan-400 hover:to-emerald-400 text-gray-950 font-bold rounded-xl transition shadow-xl shadow-cyan-500/10 text-sm mb-5">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
        </svg>
        Download Sent-Code.exe (~12 MB)
      </a>

      <ul class="grid grid-cols-2 gap-2 text-xs text-gray-500">
        {["✅ No installation required", "✅ No admin privileges needed", "✅ Ships with Ollama sidecar", "✅ Grok Build CLI included"].map(s => (
          <li class="flex items-center gap-1.5">{s}</li>
        ))}
      </ul>
    </div>

    <!-- System Requirements -->
    <div class="bg-[#111318] rounded-2xl border border-[#1b1e27] p-6 mb-6">
      <h3 class="text-white font-semibold text-sm mb-4">System Requirements</h3>
      <div class="grid grid-cols-2 gap-x-8 gap-y-2 text-xs">
        {[
          ["OS", "Windows 10/11 (64-bit)"],
          ["RAM", "8 GB minimum (16 GB for local AI)"],
          ["Storage", "~5 GB (for AI model files)"],
          ["GPU", "Optional — CPU works too"],
          ["Internet", "For Grok Build cloud mode"],
          ["Node.js", "Not required (bundled)"],
        ].map(([k, v]) => (
          <div>
            <span class="text-gray-600">{k}: </span>
            <span class="text-gray-300">{v}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- First Time Setup -->
    <div class="bg-[#111318] rounded-2xl border border-[#1b1e27] p-6">
      <h3 class="text-white font-semibold text-sm mb-4">🚀 First Time Setup</h3>
      <ol class="text-xs text-gray-400 space-y-3">
        <li class="flex gap-3"><span class="text-cyan-400 font-bold shrink-0">1.</span> Run <code class="bg-[#1a1d25] px-1.5 py-0.5 rounded text-cyan-300">Sent-Code.exe</code></li>
        <li class="flex gap-3"><span class="text-cyan-400 font-bold shrink-0">2.</span> Go to <strong class="text-white">Settings → Models</strong> and choose your AI mode</li>
        <li class="flex gap-3"><span class="text-cyan-400 font-bold shrink-0">3.</span> For Grok Build: click <strong class="text-white">Login with Grok</strong> and authenticate via browser</li>
        <li class="flex gap-3"><span class="text-cyan-400 font-bold shrink-0">4.</span> For Qwen-Coder (offline): click <strong class="text-white">Download Model</strong> and wait ~4.7 GB download</li>
        <li class="flex gap-3"><span class="text-cyan-400 font-bold shrink-0">5.</span> Start chatting — paste screenshots (Ctrl+V) or type your request</li>
      </ol>
    </div>
  </main>
</body>
</html>
